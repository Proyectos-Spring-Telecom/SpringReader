APP_NAME=SpringReader
APP_PORT=8001
APP_ENV=development
LOG_LEVEL=INFO

# Seguridad (AUTH_ENABLED=false por defecto)
AUTH_ENABLED=false
SERVICE_API_KEY=your-service-api-key-here

# CORS (orígenes separados por coma)
CORS_ORIGINS=http://localhost:3000

# OCR
OCR_LAZY_LOAD=true
OCR_MAX_UPLOAD_SIZE=10485760
OCR_UNLOAD_TIMEOUT=600
OCR_LANG=es
OCR_USE_ANGLE_CLS=true
